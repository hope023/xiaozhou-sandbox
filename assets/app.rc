1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION __VER_TUPLE__
PRODUCTVERSION __VER_TUPLE__
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "小舟沙盒"
      VALUE "FileDescription", "小舟沙盒 - 本地加密保险库"
      VALUE "FileVersion", "__VER__"
      VALUE "InternalName", "xiaozhou-sandbox"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "xiaozhou-sandbox.exe"
      VALUE "ProductName", "小舟沙盒"
      VALUE "ProductVersion", "__VER__"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
